<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AcademiaDaDuda.Presentation.AppMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.Localization"
    Title="{loc:Translate Key='Academia da Duda'}"
    FlyoutBehavior="Flyout"
    Shell.ForegroundColor="{DynamicResource PrimaryTextColor}"
    Shell.TitleColor="{DynamicResource PrimaryTextColor}"
    FlyoutBackgroundColor="{DynamicResource SurfaceColor}"
    Shell.NavBarIsVisible="True">
    <Shell.FlyoutHeader>
        <Grid Padding="18,16" BackgroundColor="{DynamicResource SurfaceColor}">
            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Image Source="{loc:Translate Key='strBandeira'}" HeightRequest="28" WidthRequest="42" Aspect="AspectFit" />
                <Label Text="{loc:Translate Key='Academia da Duda'}" FontAttributes="Bold" VerticalOptions="Center"
                       TextColor="{DynamicResource PrimaryTextColor}" />
            </HorizontalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>
</Shell>
