<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AcademiaDaDuda.Presentation.AppMaui.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Title="Dashboard"
    BackgroundColor="#F5F6FA">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">
            <VerticalStackLayout Spacing="4">
                <Image Source="academiadoze.png" WidthRequest="300" HeightRequest="150"
                       Aspect="AspectFit" HorizontalOptions="Center"
                       SemanticProperties.Description="Academia da Duda, de Felipe Antonio Brüggemann" />
                <Label Text="Olá, Felipe!" FontSize="28" FontAttributes="Bold" TextColor="#25233A" />
                <Label Text="Visão geral da academia" FontSize="15" TextColor="#77758B" />
            </VerticalStackLayout>

            <Border Padding="22" BackgroundColor="#34245F" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="Cadastros na academia" FontSize="14" TextColor="#DDD5F5" />
                        <Label Text="{Binding TotalCadastros, StringFormat='{0:N0}'}"
                               FontSize="38" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding UltimaAtualizacao}" FontSize="12" TextColor="#C8BCEB" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="Atualizar" Command="{Binding LoadDashboardCommand}"
                            BackgroundColor="#8A6CF0" TextColor="White" VerticalOptions="Center"
                            SemanticProperties.Hint="Atualiza o total de cadastros" />
                </Grid>
            </Border>

            <Label Text="Resumo dos cadastros" FontSize="20" FontAttributes="Bold" TextColor="#25233A" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                <Border Grid.Row="0" Grid.Column="0" Padding="18" BackgroundColor="White"
                        Stroke="#E8E5F0" StrokeShape="RoundRectangle 18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenLogradourosCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Logradouros" FontSize="14" TextColor="#77758B" />
                        <Label Text="{Binding TotalLogradouros, StringFormat='{0:N0}'}" FontSize="30"
                               FontAttributes="Bold" TextColor="#5E43C5" />
                        <Label Text="Abrir cadastros  ›" FontSize="12" TextColor="#5E43C5" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="18" BackgroundColor="White"
                        Stroke="#E8E5F0" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Alunos" FontSize="14" TextColor="#77758B" />
                        <Label Text="{Binding TotalAlunos, StringFormat='{0:N0}'}" FontSize="30"
                               FontAttributes="Bold" TextColor="#168F91" />
                        <Label Text="Cadastros ativos" FontSize="12" TextColor="#77758B" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="18" BackgroundColor="White"
                        Stroke="#E8E5F0" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Colaboradores" FontSize="14" TextColor="#77758B" />
                        <Label Text="{Binding TotalColaboradores, StringFormat='{0:N0}'}" FontSize="30"
                               FontAttributes="Bold" TextColor="#D65D85" />
                        <Label Text="Cadastros ativos" FontSize="12" TextColor="#77758B" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="18" BackgroundColor="White"
                        Stroke="#E8E5F0" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Matrículas" FontSize="14" TextColor="#77758B" />
                        <Label Text="{Binding TotalMatriculas, StringFormat='{0:N0}'}" FontSize="30"
                               FontAttributes="Bold" TextColor="#CE8C27" />
                        <Label Text="Cadastros ativos" FontSize="12" TextColor="#77758B" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Gerenciar logradouros" Command="{Binding OpenLogradourosCommand}"
                    BackgroundColor="#6C4CE5" TextColor="White" FontAttributes="Bold"
                    HeightRequest="52" CornerRadius="16" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="#6C4CE5" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

