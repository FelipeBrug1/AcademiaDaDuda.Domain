<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:loc="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.Localization"
    x:Class="AcademiaDaDuda.Presentation.AppMaui.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.ViewModels"
    x:DataType="vm:DashboardViewModel"
    Title="{loc:Translate Key='MenuDashboard'}"
    BackgroundColor="{DynamicResource PageBackgroundColor}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="22">
            <VerticalStackLayout Spacing="4">
                <Image Source="academiadoze.png" WidthRequest="300" HeightRequest="150"
                       Aspect="AspectFit" HorizontalOptions="Center"
                       SemanticProperties.Description="{loc:Translate Key='Academia da Duda, de Felipe Antonio Brüggemann'}" />
                <Label Text="{loc:Translate Key='Olá, Felipe!'}" FontSize="28" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                <Label Text="{loc:Translate Key='Visão geral da academia'}" FontSize="15" TextColor="{DynamicResource SecondaryTextColor}" />
            </VerticalStackLayout>

            <Border Padding="22" BackgroundColor="{DynamicResource DashboardFeatureBackgroundColor}" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                        <Label Text="{loc:Translate Key='Cadastros na academia'}" FontSize="14" TextColor="{DynamicResource DashboardFeatureSecondaryColor}" />
                        <Label Text="{loc:TranslateFormat Key='{0:N0}', Value={Binding TotalCadastros}}"
                               FontSize="38" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding UltimaAtualizacao}" FontSize="12" TextColor="{DynamicResource DashboardFeatureMutedColor}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{loc:Translate Key='Atualizar'}" Command="{Binding LoadDashboardCommand}"
                            BackgroundColor="{DynamicResource BrandAccentColor}" TextColor="White" VerticalOptions="Center"
                            SemanticProperties.Hint="{loc:Translate Key='Atualiza o total de cadastros'}">
                        <Button.ImageSource>
                            <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe5d5;" />
                        </Button.ImageSource>
                    </Button>
                </Grid>
            </Border>

            <Label Text="{loc:Translate Key='Resumo dos cadastros'}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                <Border Grid.Row="0" Grid.Column="0" Padding="18" BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenLogradourosCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate Key='MenuLogradouros'}" FontSize="14" TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Text="{loc:TranslateFormat Key='{0:N0}', Value={Binding TotalLogradouros}}" FontSize="30"
                               FontAttributes="Bold" TextColor="{DynamicResource BrandColor}" />
                        <Label Text="{loc:Translate Key='Abrir cadastros  ›'}" FontSize="12" TextColor="{DynamicResource BrandColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Padding="18" BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAlunosCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate Key='MenuAlunos'}" FontSize="14" TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Text="{loc:TranslateFormat Key='{0:N0}', Value={Binding TotalAlunos}}" FontSize="30"
                               FontAttributes="Bold" TextColor="{DynamicResource StudentStatColor}" />
                        <Label Text="{loc:Translate Key='Abrir cadastros  ›'}" FontSize="12" TextColor="{DynamicResource BrandColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Padding="18" BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenColaboradoresCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate Key='MenuColaboradores'}" FontSize="14" TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Text="{loc:TranslateFormat Key='{0:N0}', Value={Binding TotalColaboradores}}" FontSize="30"
                               FontAttributes="Bold" TextColor="{DynamicResource EmployeeStatColor}" />
                        <Label Text="{loc:Translate Key='Abrir cadastros  ›'}" FontSize="12" TextColor="{DynamicResource BrandColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Padding="18" BackgroundColor="{DynamicResource SurfaceColor}"
                        Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenMatriculasCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{loc:Translate Key='Matrículas'}" FontSize="14" TextColor="{DynamicResource SecondaryTextColor}" />
                        <Label Text="{loc:TranslateFormat Key='{0:N0}', Value={Binding TotalMatriculas}}" FontSize="30"
                               FontAttributes="Bold" TextColor="{DynamicResource EnrollmentStatColor}" />
                        <Label Text="{loc:Translate Key='Abrir cadastros  ›'}" FontSize="12" TextColor="{DynamicResource BrandColor}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="{loc:Translate Key='Gerenciar logradouros'}" Command="{Binding OpenLogradourosCommand}"
                    BackgroundColor="{DynamicResource BrandColor}" TextColor="White" FontAttributes="Bold"
                    HeightRequest="52" CornerRadius="16" />
            <Button Text="{loc:Translate Key='Controle de Acesso'}" Command="{Binding OpenAcessoCommand}"
                    BackgroundColor="{DynamicResource BrandAccentColor}" TextColor="White" FontAttributes="Bold"
                    HeightRequest="52" CornerRadius="16" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource BrandColor}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

