<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:loc="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.Localization"
    x:Class="AcademiaDaDuda.Presentation.AppMaui.Views.MatriculaListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDaDuda.Application.DTOs;assembly=AcademiaDaDuda.Application"
    xmlns:converters="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.Converters"
    x:DataType="vm:MatriculaListViewModel"
    Title="{loc:Translate Key='Matrículas'}"
    BackgroundColor="{DynamicResource PageBackgroundColor}">
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid.Padding>
            <OnPlatform x:TypeArguments="Thickness">
                <On Platform="Android">14,12</On>
                <On Platform="iOS">14,24,14,12</On>
                <On Platform="WinUI">28,20</On>
                <On Platform="MacCatalyst">28,20</On>
            </OnPlatform>
        </Grid.Padding>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                <Label Text="{loc:Translate Key='Matrículas'}" FontSize="27" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                <Label Text="{loc:TranslateFormat Key='{0:N0} cadastros', Value={Binding Matriculas.Count}}" FontSize="13" TextColor="{DynamicResource SecondaryTextColor}" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="{loc:Translate Key='＋ Nova matrícula'}" Command="{Binding AddMatriculaCommand}"
                    BackgroundColor="{DynamicResource BrandColor}" TextColor="White" FontAttributes="Bold"
                    VerticalOptions="Center" CornerRadius="14" />
        </Grid>

        <Border Grid.Row="1" Padding="10" BackgroundColor="{DynamicResource SurfaceColor}"
                Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 16">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Picker Title="{loc:Translate Key='Campo'}" WidthRequest="145" ItemsSource="{Binding FilterTypes}"
                        ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedFilterType}" FontSize="13"
                        TextColor="{DynamicResource PrimaryTextColor}" />
                <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="{loc:Translate Key='Digite o valor da busca'}"
                       ReturnType="Search" ReturnCommand="{Binding SearchMatriculasCommand}"
                       ClearButtonVisibility="WhileEditing" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="{loc:Translate Key='Buscar'}" Command="{Binding SearchMatriculasCommand}"
                        BackgroundColor="{DynamicResource BrandSoftColor}" TextColor="{DynamicResource BrandDarkColor}"
                        CornerRadius="12" Padding="14,8" SemanticProperties.Hint="{loc:Translate Key='Buscar matrículas'}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding Matriculas}" SelectionMode="None" Margin="2">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="25" Spacing="10" VerticalOptions="Center">
                            <Label Text="{loc:Translate Key='Nenhuma matrícula encontrada'}" FontSize="18" FontAttributes="Bold"
                                   TextColor="{DynamicResource PrimaryTextColor}" HorizontalTextAlignment="Center" />
                            <Label Text="{loc:Translate Key='As matrículas cadastradas aparecerão aqui. Você pode buscar por aluno, plano, objetivo ou identificador.'}"
                                   FontSize="14" TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="Center" />
                            <Button Text="{loc:Translate Key='Criar matrícula'}" Command="{Binding AddMatriculaCommand}"
                                    BackgroundColor="{DynamicResource BrandColor}" TextColor="White" CornerRadius="14"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MatriculaDto">
                            <Border Margin="0,0,0,10" Padding="15" BackgroundColor="{DynamicResource SurfaceColor}"
                                    Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="72,*" ColumnSpacing="12">
                                        <Border HeightRequest="68" WidthRequest="68" StrokeThickness="0"
                                                BackgroundColor="{DynamicResource SurfaceMutedColor}"
                                                StrokeShape="RoundRectangle 34" VerticalOptions="Start">
                                            <Image Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                                   HeightRequest="68" WidthRequest="68" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding AlunoMatricula.Nome}" FontSize="17" FontAttributes="Bold"
                                                       TextColor="{DynamicResource PrimaryTextColor}" VerticalOptions="Center"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1" Text="{Binding Plano, Converter={StaticResource EnumDisplay}}"
                                                       FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource BrandColor}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <Label Text="{loc:TranslateFormat Key='CPF: {0}', Value={Binding AlunoMatricula.Cpf}}" FontSize="12"
                                                   TextColor="{DynamicResource SecondaryTextColor}" />
                                            <Label Text="{loc:TranslateFormat Key='Nascimento: {0:d}', Value={Binding AlunoMatricula.DataNascimento}}" FontSize="12"
                                                   TextColor="{DynamicResource SecondaryTextColor}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Label Text="{loc:TranslateFormat Key='Início: {0:d}', Value={Binding DataInicio}}" FontSize="12"
                                           TextColor="{DynamicResource SecondaryTextColor}" />
                                    <Label Text="{loc:TranslateFormat Key='Término: {0:d}', Value={Binding DataFim}}" FontSize="12"
                                           TextColor="{DynamicResource SecondaryTextColor}" />
                                    <Label Text="{loc:TranslateFormat Key='Objetivo: {0}', Value={Binding Objetivo}}" FontSize="13"
                                           TextColor="{DynamicResource PrimaryTextColor}" />
                                    <Label Text="{loc:TranslateFormat Key='Restrições: {0}', Value={Binding RestricoesMedicas, Converter={StaticResource EnumDisplay}}}"
                                           FontSize="12" TextColor="{DynamicResource SecondaryTextColor}" />
                                    <Label Text="{loc:TranslateFormat Key='Observações: {0}', Value={Binding ObservacoesRestricoes}}" FontSize="12"
                                           TextColor="{DynamicResource SecondaryTextColor}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <Button Text="{loc:Translate Key='Editar'}" Clicked="OnEditButtonClicked" CommandParameter="{Binding .}"
                                                BackgroundColor="{DynamicResource BrandSoftColor}" TextColor="{DynamicResource BrandDarkColor}"
                                                CornerRadius="11" />
                                        <Button Grid.Column="1" Text="{loc:Translate Key='Excluir'}" Clicked="OnDeleteButtonClicked" CommandParameter="{Binding .}"
                                                BackgroundColor="{DynamicResource SurfaceMutedColor}" TextColor="{DynamicResource PrimaryTextColor}"
                                                CornerRadius="11" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource BrandColor}" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,10,0,0" />
        </Grid>
    </Grid>
</ContentPage>
