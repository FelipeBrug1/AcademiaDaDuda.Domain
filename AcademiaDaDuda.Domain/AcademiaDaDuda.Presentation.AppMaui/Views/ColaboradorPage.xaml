<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:loc="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.Localization"
    x:Class="AcademiaDaDuda.Presentation.AppMaui.Views.ColaboradorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.ViewModels"
    xmlns:converters="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.Converters"
    x:DataType="vm:ColaboradorViewModel"
    Title="{Binding Title}"
    BackgroundColor="{DynamicResource PageBackgroundColor}">
    <ContentPage.Resources>
        <converters:DateOnlyToDateTimeConverter x:Key="DateOnlyConverter" />
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
    </ContentPage.Resources>

    <ScrollView>
        <ScrollView.Padding>
            <OnPlatform x:TypeArguments="Thickness">
                <On Platform="Android">14,12,14,24</On>
                <On Platform="iOS">14,28,14,20</On>
                <On Platform="WinUI">32,24</On>
                <On Platform="MacCatalyst">32,24</On>
            </OnPlatform>
        </ScrollView.Padding>
        <VerticalStackLayout Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Title}" FontSize="27" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                <Label Text="{loc:Translate Key='Dados pessoais, vínculo de trabalho, foto e endereço.'}" FontSize="14" TextColor="{DynamicResource SecondaryTextColor}" />
            </VerticalStackLayout>

            <Border Padding="16" BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate Key='CPF'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding Colaborador.Cpf}" Placeholder="000.000.000-00" Keyboard="Numeric"
                               MaxLength="14" IsReadOnly="{Binding IsEditMode}" ClearButtonVisibility="WhileEditing"
                               ReturnType="Search" ReturnCommand="{Binding SearchByCpfCommand}" />
                        <Button Grid.Column="1" Text="{loc:Translate Key='Buscar'}" Command="{Binding SearchByCpfCommand}"
                                BackgroundColor="{DynamicResource BrandSoftColor}" TextColor="{DynamicResource BrandDarkColor}"
                                CornerRadius="12" Padding="14,8" />
                    </Grid>
                    <Label Text="{loc:Translate Key='Ao localizar um CPF cadastrado, os dados serão carregados para edição.'}"
                           FontSize="12" TextColor="{DynamicResource SecondaryTextColor}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Key='Dados pessoais'}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource BrandDarkColor}" />
                    <Label Text="{loc:TranslateFormat Key='Colaborador ID: {0}', Value={Binding Colaborador.Id}}" IsVisible="{Binding IsEditMode}"
                           FontSize="12" TextColor="{DynamicResource SecondaryTextColor}" />
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{loc:Translate Key='Nome completo'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                        <Entry Text="{Binding Colaborador.Nome}" Placeholder="{loc:Translate Key='Digite o nome completo'}" MaxLength="150"
                               ClearButtonVisibility="WhileEditing" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{loc:Translate Key='Data de nascimento'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                            <DatePicker Date="{Binding Colaborador.DataNascimento, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}"
                                        Format="{Binding DatePickerFormat}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="{loc:Translate Key='Telefone'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                            <Entry Text="{Binding Colaborador.Telefone}" Placeholder="(00) 00000-0000" Keyboard="Telephone"
                                   MaxLength="15" ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{loc:Translate Key='E-mail'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                        <Entry x:Name="EmailEntry" Text="{Binding Colaborador.Email}" Placeholder="exemplo@email.com" Keyboard="Email"
                               Unfocused="OnEmailUnfocused"
                               MaxLength="100" ClearButtonVisibility="WhileEditing" />
                        <Label x:Name="EmailErrorLabel" FontSize="12" TextColor="#D92D20" IsVisible="False" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="5">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{loc:Translate Key='Senha'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" VerticalOptions="Center" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Switch Toggled="OnShowPasswordToggled" Scale="0.85" />
                                    <Label Text="{loc:Translate Key='Mostrar'}" FontSize="12" TextColor="{DynamicResource SecondaryTextColor}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Entry x:Name="SenhaEntry" Text="{Binding Colaborador.Senha}" Placeholder="{loc:Translate Key='Mínimo 6 caracteres e uma maiúscula'}"
                                   IsPassword="True" MaxLength="50" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="{loc:Translate Key='Confirmar senha'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                            <Entry x:Name="ConfirmarSenhaEntry" Text="{Binding ConfirmarSenha}" Placeholder="{loc:Translate Key='Repita a senha'}" IsPassword="True" MaxLength="50" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label Text="{loc:Translate Key='Na edição, deixe os dois campos de senha vazios para manter a senha atual.'}"
                           IsVisible="{Binding IsEditMode}" FontSize="12" TextColor="{DynamicResource SecondaryTextColor}" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="14">
                    <Label Text="{loc:Translate Key='Dados de trabalho'}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource BrandDarkColor}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{loc:Translate Key='Data de admissão'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                            <DatePicker Date="{Binding Colaborador.DataAdmissao, Converter={StaticResource DateOnlyConverter}, Mode=TwoWay}"
                                        Format="{Binding DatePickerFormat}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="{loc:Translate Key='Tipo'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                            <Picker ItemsSource="{Binding ColaboradorTipos}" SelectedItem="{Binding Colaborador.Tipo}">
                                <Picker.ItemDisplayBinding>
                                    <Binding Converter="{StaticResource EnumDisplay}" />
                                </Picker.ItemDisplayBinding>
                            </Picker>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{loc:Translate Key='Vínculo'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                        <Picker ItemsSource="{Binding ColaboradorVinculos}" SelectedItem="{Binding Colaborador.Vinculo}">
                            <Picker.ItemDisplayBinding>
                                <Binding Converter="{StaticResource EnumDisplay}" />
                            </Picker.ItemDisplayBinding>
                        </Picker>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="{loc:Translate Key='Foto do colaborador'}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource BrandDarkColor}"
                           HorizontalTextAlignment="Center" />
                    <Border Padding="4" BackgroundColor="{DynamicResource SurfaceMutedColor}"
                            Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18" HorizontalOptions="Center">
                        <Image Source="{Binding FotoSource}"
                               WidthRequest="160" HeightRequest="160" Aspect="AspectFill"
                               SemanticProperties.Description="{loc:Translate Key='Foto do colaborador. Toque para selecionar outra imagem.'}">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPhotoCommand}" />
                            </Image.GestureRecognizers>
                        </Image>
                    </Border>
                    <Label Text="{loc:Translate Key='A foto fica armazenada junto ao cadastro.'}" FontSize="12"
                           TextColor="{DynamicResource SecondaryTextColor}" HorizontalTextAlignment="Center" />
                    <Button Text="{loc:Translate Key='Selecionar na galeria ou tirar foto'}" Command="{Binding SelectPhotoCommand}"
                            BackgroundColor="{DynamicResource BrandSoftColor}" TextColor="{DynamicResource BrandDarkColor}"
                            FontAttributes="Bold" CornerRadius="12" />
                </VerticalStackLayout>
            </Border>

            <Border Padding="18" BackgroundColor="{DynamicResource SurfaceColor}"
                    Stroke="{DynamicResource BorderColor}" StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="13">
                    <Label Text="{loc:Translate Key='Endereço'}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource BrandDarkColor}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry Text="{Binding Colaborador.Endereco.Cep}" Placeholder="00000-000" Keyboard="Numeric"
                               MaxLength="9" ClearButtonVisibility="WhileEditing" ReturnType="Search"
                               ReturnCommand="{Binding SearchByCepCommand}" />
                        <Button Grid.Column="1" Text="{loc:Translate Key='Buscar CEP'}" Command="{Binding SearchByCepCommand}"
                                BackgroundColor="{DynamicResource BrandSoftColor}" TextColor="{DynamicResource BrandDarkColor}"
                                CornerRadius="12" Padding="14,8" />
                    </Grid>
                    <Border Padding="12" BackgroundColor="{DynamicResource SurfaceMutedColor}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12" IsVisible="{Binding HasNoEnderecoVinculado}">
                        <Label Text="{loc:Translate Key='Informe um CEP já cadastrado em Logradouros e toque em Buscar CEP.'}"
                               FontSize="13" TextColor="{DynamicResource SecondaryTextColor}" />
                    </Border>
                    <Border Padding="12" BackgroundColor="{DynamicResource BrandSoftColor}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 12" IsVisible="{Binding HasEnderecoVinculado}">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{loc:Translate Key='Logradouro vinculado'}" FontAttributes="Bold" TextColor="{DynamicResource BrandDarkColor}" />
                            <Label Text="{loc:TranslateFormat Key='Rua: {0}', Value={Binding Colaborador.Endereco.Nome}}" />
                            <Label Text="{loc:TranslateFormat Key='Bairro: {0}', Value={Binding Colaborador.Endereco.Bairro}}" />
                            <Label Text="{loc:TranslateFormat Key='Cidade: {0}', Value={Binding Colaborador.Endereco.Cidade}}" />
                            <Label Text="{loc:TranslateFormat Key='Estado: {0}', Value={Binding Colaborador.Endereco.Estado}}" />
                        </VerticalStackLayout>
                    </Border>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{loc:Translate Key='Número'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                            <Entry Text="{Binding Colaborador.Numero}" Placeholder="{loc:Translate Key='Número'}" MaxLength="20" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="{loc:Translate Key='Complemento'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource PrimaryTextColor}" />
                            <Entry Text="{Binding Colaborador.Complemento}" Placeholder="{loc:Translate Key='Opcional'}" MaxLength="50" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{DynamicResource BrandColor}" HorizontalOptions="Center" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="{loc:Translate Key='Cancelar'}" Command="{Binding CancelCommand}" BackgroundColor="{DynamicResource SurfaceMutedColor}"
                        TextColor="{DynamicResource PrimaryTextColor}" CornerRadius="14" HeightRequest="50" />
                <Button Grid.Column="1" Text="{Binding SaveButtonText}" Command="{Binding SaveColaboradorCommand}"
                        BackgroundColor="{DynamicResource BrandColor}" TextColor="White" FontAttributes="Bold"
                        CornerRadius="14" HeightRequest="50" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
