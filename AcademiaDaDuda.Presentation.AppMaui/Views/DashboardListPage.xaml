<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AcademiaDaDuda.Presentation.AppMaui.ViewModels"
             x:Class="AcademiaDaDuda.Presentation.AppMaui.Views.DashboardListPage"
             x:DataType="viewmodels:DashboardListViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <Grid RowDefinitions="Auto,*" Padding="20">
            <!-- Cabeçalho com Logo e Título -->
            <StackLayout Grid.Row="0" Spacing="10" HorizontalOptions="Center" Margin="0,0,0,25">
                <Image Source="academiadoze.png"
                       HeightRequest="120"
                       WidthRequest="120"
                       HorizontalOptions="Center" />

                <Label Text="Academia Tio Alisson"
                       Style="{StaticResource Headline}"
                       HorizontalTextAlignment="Center" />

                <Label Text="Sistema de Gerenciamento"
                       Style="{StaticResource SubHeadline}"
                       HorizontalTextAlignment="Center" />
            </StackLayout>

            <!-- Grade de Cartões com Ícones -->
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*" RowSpacing="15" ColumnSpacing="15">
                <!-- Card Logradouros -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToLogradourosCommand}"/>
                    </Border.GestureRecognizers>
                    <StackLayout Spacing="8" Padding="15">
                        <Label FontFamily="MaterialIcons" Text="&#xe7f1;" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding TotalLogradouros}" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>
                        <Label Text="Logradouros" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Border>

                <!-- Card Alunos -->
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToAlunosCommand}"/>
                    </Border.GestureRecognizers>
                    <StackLayout Spacing="8" Padding="15">
                        <Label FontFamily="MaterialIcons" Text="&#xe88c;" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding TotalAlunos}" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>
                        <Label Text="Alunos" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Border>

                <!-- Card Colaboradores -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToColaboradoresCommand}"/>
                    </Border.GestureRecognizers>
                    <StackLayout Spacing="8" Padding="15">
                        <Label FontFamily="MaterialIcons" Text="&#xea67;" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding TotalColaboradores}" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>
                        <Label Text="Colaboradores" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Border>

                <!-- Card Matrículas -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMatriculasCommand}"/>
                    </Border.GestureRecognizers>
                    <StackLayout Spacing="8" Padding="15">
                        <Label FontFamily="MaterialIcons" Text="&#xefec;" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>
                        <Label Text="{Binding TotalMatriculas}" Style="{StaticResource SubHeadline}" HorizontalTextAlignment="Center"/>
                        <Label Text="Matrículas" HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </Border>
            </Grid>

            <!-- Indicador de Carregamento -->
            <ActivityIndicator Grid.RowSpan="2"
                               IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </ScrollView>
</ContentPage>